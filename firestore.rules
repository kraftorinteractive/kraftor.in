// Firestore rules shared by the Kraftor website, the old portal and the Kraftor Android app.
// Restored from the live ruleset of 1 Aug 2026 (db6ecf19). The website reuses these collections
// (contact_messages, job_applications, pending_registrations, users with role admin/client/employee),
// so it needs no extra rules. Edit with care: the Android app depends on these too.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // settings
    // Any authenticated user can read (needed to load prefix/GST defaults).
    // Only admin can write.
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // pending_registrations
    // Public write (anyone can submit form)
    // Only admin can read, delete or update.
    match /pending_registrations/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // counters
    // Only admin can modify counters to prevent invoice/quotation number manipulation
    match /counters/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // users
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // projects
    function isPhaseAssignee(data) {
      return 'phaseAssignees' in data && data.phaseAssignees.hasAny([request.auth.uid]);
    }

    function isProjectParticipant(data) {
      return isAuth() && (
        data.clientUid == request.auth.uid ||
        data.assignedToUid == request.auth.uid ||
        ('phaseAssignees' in data && data.phaseAssignees.hasAny([request.auth.uid]))
      );
    }

    function chatOpen(data) {
      return !(data.status in ['Completed', 'Cancelled']);
    }

    function onlyChatFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'lastMessageAt', 'lastMessageText', 'lastMessageBy',
        'lastMessageByName', 'chatReads'
      ]);
    }

    match /projects/{projectId} {
      allow read:   if isAdmin()
                    || (isAuth() && resource.data.clientUid == request.auth.uid)
                    || (isAuth() && resource.data.assignedToUid == request.auth.uid)
                    || (isAuth() && isPhaseAssignee(resource.data));
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isAuth() && resource.data.assignedToUid == request.auth.uid)
                    || (isAuth() && isPhaseAssignee(resource.data))
                    // NEW: lets the client update chat read-state / last-message
                    || (isProjectParticipant(resource.data) && onlyChatFieldsChanged());
      allow delete: if isAdmin();

      // The discussion thread itself.
      match /messages/{messageId} {
        function project() {
          return get(/databases/$(database)/documents/projects/$(projectId)).data;
        }

        // "Delete for everyone" writes a tombstone rather than removing the
        // document, and may only touch those fields — the sender, timestamp
        // and reply link can never be rewritten.
        function isTombstoneEdit() {
          return request.resource.data.deleted == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'deleted', 'deletedAt', 'text',
                 'attachmentUrl', 'attachmentName', 'attachmentType'
               ]);
        }

        allow read: if isAdmin() || isProjectParticipant(project());

        allow create: if (isAdmin() || isProjectParticipant(project()))
                      && chatOpen(project())
                      && request.resource.data.senderUid == request.auth.uid;

        allow update: if isTombstoneEdit()
                      && (isAdmin() || resource.data.senderUid == request.auth.uid);

        // Documents are never removed, so the thread always shows that a
        // message existed and was withdrawn.
        allow delete: if false;
      }

      // Typing presence: a single doc holding { uid: { name, at } }.
      // Each participant may only add or clear their own entry.
      match /presence/{docId} {
        function project() {
          return get(/databases/$(database)/documents/projects/$(projectId)).data;
        }

        allow read: if isAdmin() || isProjectParticipant(project());

        // Split create/update: on the very first write the document does not
        // exist yet, so resource.data is unavailable for a diff.
        allow create: if (isAdmin() || isProjectParticipant(project()))
                      && request.resource.data.keys().hasOnly([request.auth.uid]);

        allow update: if (isAdmin() || isProjectParticipant(project()))
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly([request.auth.uid]);

        allow delete: if false;
      }
    }

    // contact_messages
    match /contact_messages/{docId} {
      allow create: if true;
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // custom_package_leads
    match /custom_package_leads/{docId} {
      allow create: if true;
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // chatbot_leads — captured via the website chatbot widget
    match /chatbot_leads/{docId} {
      allow create: if true;
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // job_applications
    match /job_applications/{docId} {
      allow create: if true;
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // invoices
    // Split get/list so getInvoiceById() (standalone viewer) works even when
    // the document is fetched directly without a collection query.
    match /invoices/{invId} {
      allow list:   if isAdmin()
                    || (isAuth() && resource.data.clientUid == request.auth.uid);
      allow get:    if isAdmin()
                    || (isAuth() && resource.data.clientUid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // quotations
    // Admin: full access. Client: read their own + update status (accept/decline).
    match /quotations/{qtnId} {
      allow list:   if isAdmin()
                    || (isAuth() && resource.data.clientUid == request.auth.uid);
      allow get:    if isAdmin()
                    || (isAuth() && resource.data.clientUid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isAuth() && resource.data.clientUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // leave_requests
    match /leave_requests/{docId} {
      allow create: if isAuth() && hasRole('employee');
      allow read:   if isAdmin()
                    || (isAuth() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // shared_documents
    match /shared_documents/{docId} {
      allow create: if isAdmin();
      allow read:   if isAdmin()
                    || (isAuth() && resource.data.recipientUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // attendance
    // get  — single-document fetch (clockIn duplicate check); doc may not exist
    //        yet so resource is null — use doc ID prefix slice instead.
    // list — collection query; docs exist, resource.data.uid is safe.
    match /attendance/{docId} {
      allow create: if isAuth() && request.auth.uid == request.resource.data.uid;
      allow update: if isAdmin()
                    || (isAuth()
                        && request.auth.uid == resource.data.uid
                        && request.auth.uid == request.resource.data.uid);
      allow get:    if isAdmin()
                    || (isAuth()
                        && docId[0:request.auth.uid.size()] == request.auth.uid);
      allow list:   if isAdmin()
                    || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // employee_documents
    match /employee_documents/{docId} {
      allow create: if isAuth() && hasRole('employee')
                    && request.auth.uid == request.resource.data.uid;
      allow read:   if isAdmin()
                    || (isAuth() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // employee_applications
    match /employee_applications/{docId} {
      allow create: if (isAuth() && hasRole('employee')
                    && request.auth.uid == request.resource.data.uid)
                    || isAdmin();
      allow read:   if isAdmin()
                    || (isAuth() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuth()
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // salary_slips
    // Admin: full access. Employee: read their own slip only.
    match /salary_slips/{slipId} {
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
      allow list:   if isAdmin()
                    || (isAuth() && resource.data.employeeUid == request.auth.uid);
      allow get:    if isAdmin()
                    || (isAuth() && resource.data.employeeUid == request.auth.uid);
    }

    // meetings
    match /meetings/{meetingId} {
      allow create: if isAuth() && request.resource.data.clientUid == request.auth.uid;
      allow read:   if isAdmin()
                    || (isAuth() && resource.data.clientUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // crew — public "Meet the crew" list for the website (added Oct 2026).
    // Holds only name / title / photo, copied by an admin from users/{uid} where showOnCrew == true,
    // so visitors never need read access to users (emails, phones, addresses stay private).
    match /crew/{uid} {
      allow read:  if true;
      allow write: if isAdmin()
                    && request.resource.data.keys().hasOnly(['name', 'title', 'avatar', 'order', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // special_offers
    match /special_offers/{docId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // push_tokens
    match /push_tokens/{uid} {
      allow read:  if isAuth();
      allow write: if isOwner(uid);
    }

  }
}
